#!/bin/bash
#ddev-generated

## Description: install recipes, settings, export configuration
## Usage: quickstart
## Example: ddev quickstart

# install the site
vendor/bin/drush site:install --site-mail=no-reply.webservices@ubc.ca --account-mail=no-reply.webservices@ubc.ca --yes

# setup sitename
echo -e "Please enter the site name: "
read sitename

# Run the main orchestration recipe
cd ${DDEV_DOCROOT}

php core/scripts/drupal recipe ../recipes/ws-recipes/ws-sci/ -v

# Enable devel
drush pm:enable devel

# Set the site name and email address
drush config-set system.site name "$sitename" -y

# Set the site name in the kraken theme
drush config-set science.settings clf_unitname "$sitename" -y

# Set media_alias_display settings
drush config-set media_alias_display.settings media_bundles.audio audio -y
drush config-set media_alias_display.settings media_bundles.file file -y
drush config-set media_alias_display.settings media_bundles.image image -y
drush config-set media_alias_display.settings media_bundles.svg_icon svg_icon -y

# Set ubc_ckeditor_widgets settings
drush config-set ubc_ckeditor_widgets.settings primary_color '#0055B7' -y
drush config-set ubc_ckeditor_widgets.settings secondary_color '#6EC4E8' -y
drush config-set ubc_ckeditor_widgets.settings tertiary_color '#BEE6F4' -y
drush config-set ubc_ckeditor_widgets.settings accent_color '#00ACCE' -y

# Remove unused keys from hidden config form modes (https://git.drupalcode.org/project/distributions_recipes/-/blob/1.0.x/docs/config_action_list.md#hidecomponents doesn't currently work)
## Homepage form mode
drush config:delete core.entity_form_display.node.homepage.default content.field_feature_link
drush config:delete core.entity_form_display.node.homepage.default content.field_feature_text
drush config:delete core.entity_form_display.node.homepage.default content.field_home_feature_image
## Homepage featured_content display
drush config:delete core.entity_view_display.node.homepage.featured_content content.field_feature_link
drush config:delete core.entity_view_display.node.homepage.featured_content content.field_feature_text
drush config:delete core.entity_view_display.node.homepage.featured_content content.field_home_feature_image
## Landing Page featured_content display
drush config:delete core.entity_view_display.node.ubc_landing_page.featured_content content.field_landing_feature_image
## Profile form mode
drush config:delete core.entity_form_display.node.ubc_profile.default content.field_profile_office

# Remove unused role
drush config:delete "user.role.content_editor"
drush config:delete "system.action.user_add_role_action.content_editor"
drush config:delete "system.action.user_remove_role_action.content_editor"

# Delete unused Article, Basic Page and Comment entities - removed as 11.4 no longer installs these by default
# drush entity:delete node --bundle=article
# drush entity:delete node --bundle=page

# Delete Article, Basic Page and Comment types - removed as 11.4 no longer installs these by default
# drush eval "\Drupal::entityTypeManager()->getStorage('node_type')->load('page')->delete();"
# drush eval "\Drupal::entityTypeManager()->getStorage('node_type')->load('article')->delete();"
# drush eval "\Drupal::entityTypeManager()->getStorage('comment_type')->load('comment')->delete();"

# Disable comment and announcement modules
# drush pmu comment - removed as 11.4 no longer installs this by default
drush pmu announcements_feed navigation layout_builder layout_discovery

# Rebuild Permissions
drush php-eval 'node_access_rebuild();'

# Run any updates
drush updb -y

# Enable the update module
drush pm:install update -y

# Export the config
drush cex -y

# Provide a link to the user 1 password reset
drush uli

echo "All done - you can now reset the admin password above ^"